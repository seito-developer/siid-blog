# ローカル開発用の環境変数のテンプレート。
# このファイルをコピーして web/.env.local を作り、値を埋める。
#   cp web/.env.example web/.env.local
# .env.local は gitignore 済み。値は Vercel のプロジェクト設定と同じものを使う。

# microCMS サービスドメイン
NEXT_PUBLIC_MICROCMS_SERVICE_DOMAIN=siid-web

# microCMS API キー（サーバー専用）
#
# 【重要1】NEXT_PUBLIC_ を付けないこと。
#   付けるとクライアントの JS バンドルに焼き込まれ、ブラウザから誰でも読める。
#
# 【重要2】必ず「サイト用」キーを使う。「入稿用」キーを入れてはいけない。
#   microCMS の API キーは用途別に2系統ある:
#
#     サイト用 … このサイト（ローカル・Vercel）で使う
#                GET のみオン / GET の「下書きの取得」はオフ / 書き込みは全てオフ
#     入稿用   … 記事入稿 AI（別リポジトリ）と web/scripts/*.mjs の手元実行で使う
#                下書きの取得と書き込みがオン。このファイルにも Vercel にも入れない
#
#   入稿用キーをここに入れると、未公開の下書き記事が公開ページと sitemap.xml に
#   露出する（2026-09-07 に本番で発生。Issue #100 / #101）。
#
#   「下書きの取得」をオフにしてもプレビューは壊れない。
#   src/app/api/preview/route.ts は記事ごとの draftKey を付けて取得するため、
#   キー側に下書き権限が無くても該当記事だけは読める。
MICROCMS_API_KEY=

# Google Analytics 測定 ID
NEXT_PUBLIC_GA_ID=

# microCMS Webhook の署名検証用シークレット（サーバー専用）
# src/app/api/revalidate/route.ts で使用。microCMS が発行する値ではなく、
# 任意の文字列を決めて microCMS の Webhook 設定と両方に同じ値を入れる。
# ローカル開発では未設定でも可（Webhook を受けないため）。
MICROCMS_WEBHOOK_SECRET=
